# Copie para .env (que NÃO vai para o Git) e ajuste os valores.
DOCKERHUB_USER=seu-usuario
TAG=latest
DB_PASSWORD=agenda-segredo
DB_ROOT_PASSWORD=root-segredo

# Feature toggles
FEATURE_BUSCA=false

# Quantidade de réplicas da aplicação atrás do NGINX
APP_REPLICAS=2

# Portas publicadas pelo NGINX
HTTP_PORT=8000
HTTPS_PORT=8443

# Imagem já publicada a usar no lugar do build local (opcional)
# IMAGEM_APP=ghcr.io/seu-usuario/php-moderno-agenda-eventos:sha-xxxxxxx
