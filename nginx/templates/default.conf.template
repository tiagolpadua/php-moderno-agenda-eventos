# NGINX da Agenda de Eventos (semana 6): HTTPS, FastCGI (PHP-FPM), cache, gzip e load balancing.
#
# Este arquivo é um TEMPLATE: ao iniciar, a imagem oficial do NGINX troca ${HTTPS_PORTA_PUBLICA}
# pelo valor da variável de ambiente e grava o resultado em /etc/nginx/conf.d/default.conf.
# Ele é incluído dentro do bloco "http" do nginx.conf da imagem.
# Documentação: https://nginx.org/en/docs/

# ------------------------------------------------------------------
# Configurações gerais (contexto http)
# ------------------------------------------------------------------
server_tokens off;                      # não revela a versão do NGINX

resolver 127.0.0.11 valid=10s ipv6=off; # DNS interno do Docker

log_format balanceamento '$remote_addr "$request" $status '
                         'upstream=$upstream_addr cache=$upstream_cache_status '
                         'tempo=${request_time}s';

# Compressão gzip para respostas de texto
gzip on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_vary on;
gzip_types text/css application/json application/javascript text/plain image/svg+xml;

# API gateway: até 10 requisições/segundo por IP (com rajadas de até 20)
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

# Cache das respostas FastCGI (microcache da API)
fastcgi_cache_path /var/cache/nginx/agenda levels=1:2 keys_zone=agenda_cache:10m
                   max_size=100m inactive=10m use_temp_path=off;
fastcgi_cache_key "$scheme$request_method$host$request_uri";

# ------------------------------------------------------------------
# Load balancer: réplicas PHP-FPM
# ------------------------------------------------------------------
upstream agenda_app {
    # Algoritmo: menos conexões ativas (bom quando as requisições têm durações diferentes).
    # Outras opções: (padrão) round-robin · ip_hash · hash $chave consistent · random two
    least_conn;

    zone agenda_app 64k;
    server app:9000 resolve;            # FastCGI na porta 9000 de cada réplica

    keepalive 16;                       # reaproveita conexões com o PHP-FPM
}

# ------------------------------------------------------------------
# HTTP (porta 80): só redireciona para HTTPS
# ------------------------------------------------------------------
server {
    listen 80;
    server_name _;

    # Saúde do NGINX continua disponível em HTTP (usada pelo healthcheck do container)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host:${HTTPS_PORTA_PUBLICA}$request_uri;
    }
}

# ------------------------------------------------------------------
# HTTPS (porta 443)
# ------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/agenda.crt;
    ssl_certificate_key /etc/nginx/certs/agenda.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    access_log /var/log/nginx/access.log balanceamento;

    # Cabeçalhos devolvidos ao cliente
    add_header X-Request-ID           $request_id always;
    add_header X-Upstream             $upstream_addr always;
    add_header X-Cache-Status         $upstream_cache_status always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options        DENY always;
    # HSTS: obriga o navegador a usar HTTPS. CUIDADO em "localhost": o navegador passa a
    # exigir HTTPS em TODAS as portas de localhost. Use só com domínio de verdade.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Se uma réplica falhar, tenta a próxima (failover)
    fastcgi_connect_timeout 2s;
    fastcgi_next_upstream error timeout http_503;
    fastcgi_keep_conn on;               # necessário para o keepalive do upstream

    # --------------------------------------------------------------
    # Servidor web: estáticos direto do disco, com cache no navegador
    # --------------------------------------------------------------
    location /css/ {
        root /var/www/public;
        expires 7d;
        access_log off;
    }

    # --------------------------------------------------------------
    # API gateway (com microcache de 10 s)
    # --------------------------------------------------------------
    location /api/v1/ {
        limit_req zone=api burst=20 nodelay;
        rewrite ^/api/v1/(.*)$ /api/$1 break;   # /api/v1/eventos → /api/eventos

        include /etc/nginx/snippets/fastcgi-agenda.conf;
        include /etc/nginx/snippets/cache-api.conf;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;

        include /etc/nginx/snippets/fastcgi-agenda.conf;
        include /etc/nginx/snippets/cache-api.conf;
    }

    error_page 429 = @muitas_requisicoes;
    location @muitas_requisicoes {
        default_type application/json;
        return 429 '{"erro": "Muitas requisições. Tente novamente em instantes."}\n';
    }

    error_page 502 503 504 = @indisponivel;
    location @indisponivel {
        default_type application/json;
        return 503 '{"erro": "Serviço temporariamente indisponível."}\n';
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --------------------------------------------------------------
    # Aplicação: tudo o mais vai para o front controller via FastCGI
    # --------------------------------------------------------------
    location / {
        include /etc/nginx/snippets/fastcgi-agenda.conf;
    }
}
