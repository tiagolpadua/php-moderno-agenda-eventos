{
    "name": "tiagolpadua/agenda-eventos",
    "description": "Agenda de Eventos — projeto-base da mentoria CREMESP · PHP Moderno (trilha DevOps)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
